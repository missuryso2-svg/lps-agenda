{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lps-agenda-staging",
  "account_id": "c9fd2ea0bea382bc44b053b61c7070fd",
  "main": "worker.j1.mjs",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  // Enable workers.dev only after verifying the individual Access policy for this Worker.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "images": { "binding": "UPLOAD_IMAGES", "remote": false },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "lps-agenda-staging" }
  ],
  "dev": { "ip": "127.0.0.1", "port": 59339 },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 }
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://lps-agenda-staging.lpsagenda-qa.workers.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://kffhoimijhsddodqxezs.supabase.co",
    "CSP_ENFORCE": "true",
    "MANUAL_TRIAL_ONBOARDING_ENABLED": "false",
    "ADSENSE_ENABLED": "false",
    "LPS_WORKERS_CSP_FINALIZE": "true",
    "LPS_IMAGE_PROCESSOR": "cloudflare"
  }
}
