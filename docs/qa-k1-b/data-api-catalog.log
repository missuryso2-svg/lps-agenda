  WHERE ((m.user_id = ( SELECT uid() AS uid)) AND m.is_active AND (b.avatar_url = objects.name) AND (split_part(objects.name, '/'::text, 1) = (b.barbershop_id)::text) AND (split_part(objects.name, '/'::text, 2) = (b.id)::text)))))|
